  "id": null,
  "uid": "faz-web-usage",
  "title": "FortiAnalyzer \u00b7 Historical Web Usage",
  "description": "Historical FortiView website domains, source endpoints and native time series, queried through a server-side API bridge.",
  "tags": [
    "fortianalyzer",
    "fortiview",
    "web-usage"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "title": "FortiView \u00b7 Historical web usage",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Historical website usage by endpoint.** Select a FortiGate, endpoint and time range; enter an exact website or click one below. Use `All` to clear a filter.\n\nSessions are not page views or people. Traffic charts show bytes per bucket. Selecting all FortiGates may count traffic observed more than once."
      }
    },
    {
      "id": 2,
      "title": "Website entries",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_FORTIVIEW}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_FORTIVIEW}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/api/summary?from=${__from}&to=${__to}&device=${fortigate:percentencode}&source=${endpoint:percentencode}&domain=${website:percentencode}",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "websites",
              "text": "Website entries",
              "type": "number"
            }
          ]
        }
      ]
    },
